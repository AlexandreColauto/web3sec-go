{
  "protocol_id": "golden-vault",
  "name": "Golden Vault",
  "snapshot_id": "unpinned",
  "chains": ["ethereum"],
  "subsystems": ["defi-vault"],
  "contracts": [
    {
      "name": "Vault",
      "path": "src/Vault.sol",
      "role": "core",
      "in_scope": true,
      "entry_points": ["deposit", "withdraw"],
      "state_variables": [
        {"name": "totalAssets", "kind": "balance", "accounting": true},
        {"name": "shares", "kind": "share", "accounting": true}
      ]
    },
    {
      "name": "Other",
      "path": "src/Other.sol",
      "role": "periphery",
      "in_scope": true,
      "entry_points": ["pause"]
    }
  ],
  "actors": [
    {"id": "user", "kind": "EOA", "trust": "externally-owned"},
    {"id": "admin", "kind": "ROLE", "trust": "trusted",
     "assumed_behavior": "acts only in the protocol's stated interest",
     "can_drain": true, "can_upgrade": true, "can_pause": true}
  ],
  "assets": [
    {"id": "ETH", "kind": "token", "decimals": 18},
    {"id": "share", "kind": "share", "erc": "4626", "decimals": 18}
  ],
  "privileges": [
    {"role": "admin", "capability": "withdraw", "mechanism": "onlyAdmin",
     "timelocked": false, "can_drain": true},
    {"role": "admin", "capability": "pause", "mechanism": "onlyAdmin",
     "timelocked": false}
  ],
  "trust_boundaries": [
    {"from": "user", "to": "Vault", "crossing": "user-supplied token",
     "validated": false}
  ],
  "relations": [
    {"from": "Vault", "rel": "CALLS", "to": "Other"}
  ],
  "economic_relations": [
    {"id": "EQ-1",
     "equation": "totalAssets >= sum(user_claims)",
     "meaning": "the vault is solvent for every depositor",
     "variables": ["totalAssets", "shares"],
     "enforced_by": ["Vault.deposit"],
     "breakable_by": ["donation", "rounding"]}
  ],
  "invariants": [
    {"id": "INV-1",
     "statement": "only the admin role may withdraw assets from the vault",
     "applies_to": ["Vault"], "kind": "authorization",
     "severity_if_broken": "critical"},
    {"id": "INV-2",
     "statement": "the total assets must always cover the sum of all user claims",
     "applies_to": ["Vault"], "kind": "accounting",
     "severity_if_broken": "critical"},
    {"id": "INV-3",
     "statement": "the pause role can only be granted through the timelock",
     "applies_to": ["Vault"], "kind": "authorization",
     "severity_if_broken": "high"},
    {"id": "INV-4",
     "statement": "the share price must not move in favor of existing shares from out-of-band transfers",
     "applies_to": ["Vault"], "kind": "economic",
     "severity_if_broken": "critical"}
  ]
}

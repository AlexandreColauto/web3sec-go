{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Sequence PoC spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["spec_id", "finding_id", "actors", "steps"],
  "properties": {
    "spec_id": {"type": "string", "pattern": "^SEQ-[A-Z0-9]+-[A-Za-z0-9]+$"},
    "finding_id": {"type": "string", "minLength": 3},
    "actors": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string",
        "pattern": "^(0x[0-9a-fA-F]{40}|anvil:[0-9]+)$"
      }
    },
    "steps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["step", "actor", "target", "function"],
        "properties": {
          "step": {"type": "integer", "minimum": 1},
          "actor": {"type": "string", "minLength": 1},
          "target": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
          "function": {"type": "string", "minLength": 2},
          "args": {"type": "array", "items": {"type": "string"}},
          "mine_blocks": {"type": "integer", "minimum": 0},
          "expect_revert": {"type": "boolean"}
        }
      }
    },
    "final_assertions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "op", "value"],
        "properties": {
          "id": {"type": "string", "pattern": "^A[0-9]+$"},
          "kind": {"enum": ["balance", "storage", "call"]},
          "target": {"type": "string", "pattern": "^0x[0-9a-fA-F]{40}$"},
          "account": {"type": "string"},
          "slot": {"type": "string"},
          "function": {"type": "string"},
          "args": {"type": "array", "items": {"type": "string"}},
          "op": {"enum": [">=", "<=", "==", "!="]},
          "value": {"type": "string", "pattern": "^[0-9]+$"}
        }
      }
    }
  }
}

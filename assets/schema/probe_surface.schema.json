{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://web3sec.local/schema/probe_surface.schema.json",
  "title": "WebSec Probe Surface",
  "description": "Deterministic candidate rows from the four shipped probes, per axis: sites (raw pre-discriminator hits), rows (post-discriminator candidates), emitted, tail, blind keys and quota bookkeeping. Rows are obligations to look, never claims; the surface is stamped with the index_sha it was derived from so a stale surface can be detected.",
  "type": "object",
  "additionalProperties": false,
  "required": ["campaign_id", "snapshot_id", "parse_version", "index_sha",
               "generated_at", "per_axis", "total", "floor", "axes", "rows",
               "missing", "stats"],
  "definitions": {
    "stage_site": {
      "type": "object",
      "additionalProperties": false,
      "required": ["function", "line", "kind"],
      "properties": {
        "function": { "type": "string" },
        "line": { "type": "integer" },
        "kind": { "enum": ["write", "read"] }
      }
    }
  },

  "properties": {
    "campaign_id": { "type": "string" },
    "snapshot_id": { "type": ["string", "null"] },
    "parse_version": { "const": "3", "description": "the index parse version this surface required" },
    "index_sha": { "type": "string", "pattern": "^[0-9a-f]{64}$",
                   "description": "content hash of the structural index the rows were derived from" },
    "generated_at": { "type": "string" },
    "per_axis": { "type": "integer", "minimum": 1 },
    "total": { "type": "integer", "minimum": 1 },
    "floor": { "type": "integer", "minimum": 0 },

    "axes": {
      "type": "array",
      "description": "one entry per registered probe: the four-state surface that makes closure non-vacuous",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["probe", "axis", "lens", "sites", "rows", "emitted",
                     "tail", "wanted", "floor", "per_axis", "status",
                     "blind", "blind_total"],
        "properties": {
          "probe": { "enum": ["accumulator-basis-skew", "assertion-strength",
                              "custody-primitive", "sequential-cursor",
                              "short-circuitable-guard",
                              "trust-assumption"] },
          "axis": { "type": "string" },
          "lens": { "type": "string", "pattern": "^L-0[0-9]$" },
          "sites": { "type": "integer", "minimum": 0,
                     "description": "raw hits before the shape discriminator" },
          "rows": { "type": "integer", "minimum": 0,
                    "description": "post-discriminator candidates (after sibling collapse)" },
          "emitted": { "type": "integer", "minimum": 0 },
          "tail": { "type": "integer", "minimum": 0 },
          "wanted": { "type": "integer", "minimum": 0,
                      "description": "min(per_axis, rows) before the total ceiling" },
          "floor": { "type": "integer", "minimum": 0,
                     "description": "min(floor, rows): the reserved quota the ceiling may not trim" },
          "per_axis": { "type": "integer", "minimum": 1 },
          "status": { "enum": ["emitted", "no-sites", "blind", "under-filled"] },
          "blind": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "key", "reason"],
              "properties": {
                "kind": { "type": "string" },
                "key": { "type": "string" },
                "near": { "type": ["string", "null"] },
                "contract": { "type": ["string", "null"] },
                "function": { "type": ["string", "null"] },
                "line": { "type": ["integer", "null"] },
                "actor": { "type": ["string", "null"] },
                "invariant": { "type": ["string", "null"] },
                "trust": { "type": ["string", "null"] },
                "reason": { "type": "string", "minLength": 10 }
              }
            }
          },
          "blind_total": { "type": "integer", "minimum": 0 }
        }
      }
    },

    "rows": {
      "type": "array",
      "description": "emitted candidates, ranked (tier, -assertion_gap, siblings, name) within their axis; probe-specific fields are the disposition anchor enum for that probe",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["row_id", "probe", "axis", "lens", "tier", "rank",
                     "assertion_gap", "gate", "why", "siblings"],
        "properties": {
          "row_id": { "type": "string", "pattern": "^[0-9a-f]{10}$" },
          "probe": { "enum": ["accumulator-basis-skew", "assertion-strength",
                              "custody-primitive", "sequential-cursor",
                              "short-circuitable-guard",
                              "trust-assumption"] },
          "axis": { "type": "string" },
          "lens": { "type": "string", "pattern": "^L-0[0-9]$" },
          "tier": { "type": "integer", "minimum": 0, "maximum": 2 },
          "rank": { "type": "integer", "minimum": 1 },
          "assertion_gap": { "type": "integer", "minimum": 0, "maximum": 4 },
          "gate": { "type": "string" },
          "why": { "type": "string", "minLength": 10 },
          "siblings": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["contract", "line"],
              "properties": {
                "contract": { "type": "string" },
                "line": { "type": "integer", "minimum": 0 },
                "test_double": {
                  "type": "boolean",
                  "description": "the sibling's source is test scaffolding (a mock|mocks|test|tests|harness|fixtures path, or a Mock*.sol / *Mock.sol / *.t.sol filename); the rank key counts NON-test-double siblings only and the collapsed representative prefers a non-test-double site"
                }
              }
            }
          },
          "contract": { "type": "string" },
          "consumer": { "type": "string" },
          "consumer_line": { "type": "integer", "minimum": 0 },
          "asserter": { "type": "string" },
          "asserter_line": { "type": "integer", "minimum": 0 },
          "concept_keys": { "type": "array", "items": { "type": "string" } },
          "own_class": { "type": "integer", "minimum": 0, "maximum": 4 },
          "assert_class": { "type": "integer", "minimum": 0, "maximum": 4 },
          "base": { "type": "string" },
          "base_line": { "type": "integer", "minimum": 0 },
          "custody": { "enum": ["burns", "mints"] },
          "forward": { "type": "array", "items": { "type": "string" } },
          "inherited": { "type": "boolean" },
          "actor": { "type": "string" },
          "invariant": { "type": "string" },
          "trust": { "type": "string" },
          "kind": { "enum": ["invariant", "equation"] },
          "statement": { "type": "string" },
          "guard": { "type": "string" },
          "guard_line": { "type": "integer", "minimum": 0 },
          "cursor": { "type": "string" },
          "stranded_entry": { "type": "array", "items": { "type": "string" } },
          "sentinel": { "type": "string" },
          "safety": { "type": "string" },
          "rounded_line": { "type": "integer", "minimum": 0 },
          "plain_line": { "type": "integer", "minimum": 0 },
          "accumulator": { "type": "string" },
          "companion": { "type": "string" },

          "stages_unguarded": {
            "type": "array",
            "description": "IMPROVEMENTS C1: the (write, read) enforcement stage pairs of this row's concept keys that no assertion about the key covers, scoped to this row's contract and derived deterministically from the structural index. Present only when at least one such pair exists; capped, with stages_unguarded_total carrying the true count.",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["write", "read", "write_guarded", "read_guarded",
                           "contract", "concept"],
              "properties": {
                "write": { "$ref": "#/definitions/stage_site" },
                "read": { "$ref": "#/definitions/stage_site" },
                "write_guarded": {
                  "type": "boolean",
                  "description": "the write site's function carries an assertion about the concept key"
                },
                "read_guarded": {
                  "type": "boolean",
                  "description": "the read site's function carries an assertion about the concept key"
                },
                "contract": { "type": "string" },
                "concept": { "type": "string" }
              }
            }
          },

          "stages_unguarded_total": {
            "type": "integer",
            "minimum": 1,
            "description": "the true number of uncovered stage pairs for this row, before the stages_unguarded cap"
          }
        }
      }
    },

    "missing": {
      "type": "array",
      "description": "axes whose quota was trimmed by the campaign ceiling: emitted < min(per_axis, rows). A silent 14th-place eviction is not a disposition",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["axis", "probe", "lens", "rows", "sites", "emitted",
                     "wanted", "floor", "reason"],
        "properties": {
          "axis": { "type": "string" },
          "probe": { "enum": ["accumulator-basis-skew", "assertion-strength",
                              "custody-primitive", "sequential-cursor",
                              "short-circuitable-guard",
                              "trust-assumption"] },
          "lens": { "type": "string", "pattern": "^L-0[0-9]$" },
          "rows": { "type": "integer", "minimum": 0 },
          "sites": { "type": "integer", "minimum": 0 },
          "emitted": { "type": "integer", "minimum": 0 },
          "wanted": { "type": "integer", "minimum": 0 },
          "floor": { "type": "integer", "minimum": 0 },
          "reason": { "type": "string", "minLength": 10 }
        }
      }
    },

    "warnings": {
      "type": "array",
      "description": "operator-visible arithmetic problems with the quota knobs themselves, e.g. the reserved per-axis floors exceeding --total (the ceiling can never trim below the reserve). Additive: a surface written before this key existed still validates",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "message"],
        "properties": {
          "kind": { "enum": ["floor-reserve-exceeds-total"] },
          "message": { "type": "string", "minLength": 10 }
        }
      }
    },

    "stats": {
      "type": "object",
      "additionalProperties": false,
      "required": ["probes", "axes_with_rows", "sites", "rows", "emitted",
                   "tail", "blind", "missing"],
      "properties": {
        "probes": { "type": "integer", "minimum": 0 },
        "axes_with_rows": { "type": "integer", "minimum": 0 },
        "sites": { "type": "integer", "minimum": 0 },
        "rows": { "type": "integer", "minimum": 0 },
        "emitted": { "type": "integer", "minimum": 0 },
        "tail": { "type": "integer", "minimum": 0 },
        "blind": { "type": "integer", "minimum": 0 },
        "missing": { "type": "integer", "minimum": 0 }
      }
    }
  }
}

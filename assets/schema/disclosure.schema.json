{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "disclosure",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "finding_ids", "summary", "impact", "embargo_until"],
  "properties": {
    "schema_version": {"type": "string", "enum": ["1"]},
    "finding_ids": {
      "type": "array", "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "summary": {"type": "string", "minLength": 40},
    "impact": {"type": "string", "minLength": 20},
    "affected": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["contract"],
        "properties": {
          "contract": {"type": "string", "minLength": 1},
          "chain": {"type": "string"},
          "path": {"type": "string"},
          "url": {"type": "string"}
        }
      }
    },
    "references": {"type": "array", "items": {"type": "string", "minLength": 1}},
    "embargo_until": {
      "type": ["string", "null"],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "contact": {"type": "string"},
    "reporter_credit": {"type": "string"}
  }
}

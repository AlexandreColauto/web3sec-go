{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://web3sec.local/schema/bounty_policy.schema.json",
  "title": "WebSec Bounty Policy",
  "description": "Machine-readable encoding of a bug bounty program's rules: scope, exclusions, known issues, severity floors, PoC requirements. The final gate answers 'is this submission-ready against THIS program', not merely 'is this a real bug'.",
  "type": "object",
  "additionalProperties": false,
  "required": ["program", "program_url", "chains", "scope", "severity_rules", "poc_requirements"],
  "properties": {
    "program":     { "type": "string", "minLength": 2 },
    "program_url": { "type": "string" },
    "platform":    { "enum": ["immunefi", "hackenproof", "cantina", "code4rena", "sherlock", "direct", "other"] },
    "chains":      { "type": "array", "items": { "type": "string" }, "minItems": 1 },
    "asset_weight_usd": { "type": ["number", "null"], "minimum": 0, "description": "total assets in scope, for impact calibration" },

    "scope": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["target"],
        "properties": {
          "target":     { "type": "string", "description": "contract name, path prefix, or 0x-address" },
          "kind":       { "enum": ["contract", "path", "address", "chain", "behavior"] },
          "max_severity": { "enum": ["critical", "high", "medium", "low"] }
        }
      }
    },

    "exclusions": {
      "type": "array",
      "description": "known issues and excluded behaviors — each is a tripwire for the final gate",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["pattern"],
        "properties": {
          "pattern":   { "type": "string", "description": "substring/keyword matched against finding class, title and description" },
          "kind":      { "enum": ["known-issue", "excluded-behavior", "excluded-component", "intended-behavior", "previous-report"] },
          "reference": { "type": "string", "description": "URL or note documenting the exclusion" },
          "case_sensitive": { "type": "boolean", "default": false }
        }
      }
    },

    "severity_rules": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["severity", "match"],
        "properties": {
          "severity": { "enum": ["critical", "high", "medium", "low"] },
          "match": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "bug_classes": { "type": "array", "items": { "type": "string" } },
              "min_extractable_usd": { "type": ["number", "null"], "minimum": 0 },
              "blast_radius": { "type": "array", "items": { "enum": ["single-user", "subset-of-users", "all-users", "protocol-solvency", "bridge-canonical"] } },
              "require_invariant_violation": { "type": "boolean" }
            }
          }
        }
      }
    },

    "poc_requirements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["min_evidence_level", "require_fork_repro"],
      "properties": {
        "min_evidence_level": { "enum": ["E3", "E4", "E5", "E6", "E7"] },
        "require_fork_repro": { "type": "boolean" },
        "require_economic_quantification": { "type": "boolean" },
        "require_exploit_contract": { "type": "boolean" },
        "min_extractable_usd": { "type": ["number", "null"], "minimum": 0 }
      }
    },

    "reporting": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "contact": { "type": "string" },
        "required_fields": { "type": "array", "items": { "type": "string" } },
        "notes":  { "type": "string" }
      }
    }
  }
}

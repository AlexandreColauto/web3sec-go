{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://web3sec.local/schema/operator_facts.schema.json",
  "title": "WebSec Operator Facts",
  "description": "Operator-supplied, dated, attributed facts about protocol-model components: the DNS records a domain was observed to serve and the dependency a manifest pinned. The framework NEVER resolves a name, opens a socket, or stamps a clock: a fact is a human assertion, and its observed_at is the date the OPERATOR observed it (never wall-clock time).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "facts"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "enum": [
        "1"
      ]
    },
    "facts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "target"
        ],
        "properties": {
          "target": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "enum": [
                  "frontend",
                  "relayer",
                  "keeper-service",
                  "domain",
                  "offchain-service"
                ]
              },
              "url": {
                "type": "string"
              },
              "path": {
                "type": "string"
              }
            }
          },
          "dns": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "source"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "source": {
                "type": "string",
                "minLength": 3,
                "description": "WHO supplied the fact (operator, registrar export, ticket id) and WHEN. The framework NEVER resolves DNS itself: this object is the only place a DNS fact can appear, which is why it is self-describing instead of carrying a global clock."
              },
              "records": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "a": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "aaaa": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "cname": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "ns": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "txt": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  },
                  "mx": {
                    "type": "array",
                    "items": {
                      "type": "string"
                    },
                    "uniqueItems": true
                  }
                }
              }
            }
          },
          "dependency": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "observed_at",
              "source",
              "package"
            ],
            "properties": {
              "observed_at": {
                "type": "string",
                "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
              },
              "source": {
                "type": "string",
                "minLength": 3
              },
              "package": {
                "type": "string",
                "minLength": 1
              },
              "version": {
                "type": "string"
              },
              "pin": {
                "type": "string",
                "description": "the lockfile/remappings line verbatim"
              },
              "resolved_from": {
                "type": "string",
                "description": "repo-relative manifest path"
              }
            }
          }
        }
      },
      "description": "each fact joins onto exactly one components[] entry by (kind,url) when it targets a url, else by (kind,path); a fact that matches zero or two components is an error, and a second dns/dependency fact for one component is an error"
    }
  }
}
